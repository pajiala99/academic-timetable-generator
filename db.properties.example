# Copy this file to db.properties (next to where you start the app) and edit it.
# Environment variables TIMETABLE_DB_URL, TIMETABLE_DB_USER and TIMETABLE_DB_PASSWORD
# override these values.
#
# The database is created automatically if the user is allowed to (createDatabaseIfNotExist).
db.url=jdbc:mysql://localhost:3306/timetable?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&connectTimeout=5000
db.user=root
db.password=
